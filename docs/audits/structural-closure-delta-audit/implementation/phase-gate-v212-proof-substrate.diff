+
+const allow = (from: string, to: string): LegacyTransitionDecision => ({
+  verdict: 'allow',
+  explanation: `Legacy HSM admitted ${from} -> ${to}`,
+});
+
+const deny = (guardId: string, reason: string): LegacyTransitionDecision => ({
+  verdict: 'deny',
