+      workflowType: edge.workflowType,
+      from: edge.from,
+      to: edge.to,
+      scenario: 'representative-pass',
+      state: edge.pass,
+      expected: allow(edge.from, edge.to),
+    },
+    {
+      id: `${stem}-fail`,
+      workflowType: edge.workflowType,
+      from: edge.from,
+      to: edge.to,
+      scenario: 'representative-fail',
+      state: edge.fail,
+      expected: edge.failExpected ?? deny(edge.guardId, edge.failReason),
+    },
+  ];
+}
