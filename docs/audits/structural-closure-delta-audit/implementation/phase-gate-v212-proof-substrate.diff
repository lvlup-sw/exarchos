+            gitExec: () => ({ stdout: '', exitCode: 0 }),
+            runCommand: async () => ({ exitCode: 0, stdout: '' }),
+          }, root, eventStore);
+        case 'mock-boundary':
+          return handleMockBoundary({
+            ...common,
