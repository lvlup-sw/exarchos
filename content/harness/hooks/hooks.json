{
  "hooks": {
    "SessionStart": [{
      "matcher": "startup|resume",
      "hooks": [{
        "type": "command",
        "command": "exarchos session-start",
        "timeout": 10
      }]
    }],
    "SubagentStop": [{
      "matcher": "*",
      "hooks": [{
        "type": "command",
        "command": "exarchos subagent-stop",
        "timeout": 30
      }]
    }]
  }
}
