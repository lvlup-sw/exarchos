{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": [
    "tsx"
  ],
  "ignoreExportsUsedInFile": true,
  "tags": [
    "-proof"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "src/build-skills.ts",
        "src/install-skills.ts",
        "src/skills-guard.ts",
        "src/placeholder-lint.ts",
        "scripts/audit/knip-diff.ts",
        "scripts/measured-premises-derive.ts",
        "scripts/**/*.test.ts",
        "test/**/*.test.ts",
        "test/fixtures/__helpers__/mock-mcp-server.mjs",
        "tools/conformance/src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/**/*.ts",
        "test/**/*.ts",
        "test/**/*.mjs",
        "tools/conformance/src/**/*.ts"
      ]
    },
    "servers/exarchos-mcp": {
      "entry": [
        "src/index.ts",
        "src/projections/index.ts",
        "src/projections/rehydration/fingerprint-cli.ts",
        "src/projections/rehydration/prose-lint-cli.ts",
        "src/**/*.test.ts",
        "src/**/*.bench.ts",
        "src/__tests__/**/*.ts",
        "src/bench/**/*.ts",
        "src/benchmarks/**/*.ts",
        "src/evals/**/*.ts"
      ],
      "project": [
        "src/**/*.ts"
      ],
      "ignoreDependencies": [
        "patch-package",
        "dependency-cruiser"
      ]
    }
  },
  "ignore": [
    "servers/exarchos-mcp/src/mcp/elicitation-method.ts"
  ]
}
