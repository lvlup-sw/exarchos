{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": [
    "tsx",
    "dependency-cruiser"
  ],
  "ignoreExportsUsedInFile": true,
  "tags": [
    "-proof"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "src/index.ts",
        "src/install/build-skills.ts",
        "src/install/install-skills.ts",
        "src/install/skills-guard.ts",
        "src/install/placeholder-lint.ts",
        "src/projections/index.ts",
        "src/projections/rehydration/fingerprint-cli.ts",
        "src/projections/rehydration/prose-lint-cli.ts",
        "src/**/*.test.ts",
        "src/**/*.bench.ts",
        "src/__tests__/**/*.ts",
        "tools/audit/knip-diff.ts",
        "tools/audit/gates/measured-premises-derive.ts",
        "scripts/**/*.test.ts",
        "test/**/*.test.ts",
        "tests/core/**/*.test.ts",
        "tests/helpers/__helpers__/mock-mcp-server.mjs",
        "tools/conformance/src/**/*.test.ts",
        "tools/evals/**/*.ts",
        "tools/test-helpers/**/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/**/*.ts",
        "test/**/*.ts",
        "test/**/*.mjs",
        "tests/core/**/*.ts",
        "tools/conformance/src/**/*.ts",
        "tools/evals/**/*.ts",
        "tools/test-helpers/**/*.ts"
      ]
    }
  },
  "ignore": [
    "src/mcp/elicitation-method.ts"
  ]
}
