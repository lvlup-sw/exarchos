{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": [
    "tsx",
    "dependency-cruiser"
  ],
  "ignoreExportsUsedInFile": true,
  "tags": [
    "-proof"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "src/index.ts",
        "src/install/build-skills.ts",
        "src/install/install-skills.ts",
        "src/install/skills-guard.ts",
        "src/install/placeholder-lint.ts",
        "src/projections/index.ts",
        "src/projections/rehydration/fingerprint-cli.ts",
        "src/projections/rehydration/prose-lint-cli.ts",
        "tools/audit/knip-diff.ts",
        "tools/audit/gates/measured-premises-derive.ts",
        "tests/**/*.test.ts",
        "tests/helpers/__helpers__/mock-mcp-server.mjs",
        "tools/conformance/src/**/*.test.ts",
        "tools/evals/**/*.ts",
        "tools/evals-pkg/src/index.ts",
        "tools/git-hooks/**/*.ts",
        "tools/release/**/*.ts",
        "tools/test-helpers/**/*.ts",
        "docs/.vitepress/**/*.ts",
        "src/contract/authority-lock-cli.ts",
        "src/contract/ir/admission-ir-schema-cli.ts",
        "src/contract/capsule/exarchos-capsule-schema-cli.ts",
        "tests/evals/native-baseline/emit-baseline-csv.ts",
        "tests/core/integration/suite-invariants/regenerate-baseline.ts"
      ],
      "project": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "!tests/evals/**/runs/**",
        "tools/audit/**/*.ts",
        "tools/conformance/src/**/*.ts",
        "tools/evals/**/*.ts",
        "tools/evals-pkg/**/*.ts",
        "tools/git-hooks/**/*.ts",
        "tools/release/**/*.ts",
        "tools/test-helpers/**/*.ts",
        "docs/.vitepress/**/*.ts",
        "src/install/runtimes/load.js"
      ]
    }
  },
  "ignore": [
    "src/mcp/elicitation-method.ts",
    "tools/eslint-rules/__fixtures__/**"
  ],
  "ignoreFiles": [
    "tests/evals/quality-ab/tasks/*/impl.stub.ts",
    "tests/evals/quality-ab/tasks/*/oracle.ts",
    "tools/audit/__fixtures__/comment-hygiene/*.ts",
    "src/architecture/__fixtures__/*.fixture.ts",
    "tools/conformance/src/__fixtures__/*.fixture.ts",
    "tools/audit/__shims__/*.d.ts"
  ]
}
