exports[`task 025 — per-runtime snapshot baselines > render dir: copilot > Snapshots_AllSkillsAllRuntimes_MatchBaseline: skills/copilot/ideate/SKILL.md > skills/copilot/ideate/SKILL.md 1`] = `
