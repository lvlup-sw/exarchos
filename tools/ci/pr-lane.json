    "test-root: Guard — both installer shells present": "static:installer-shells",
    "test-root: npm run typecheck": "static:tsc-build",
    "test-root: npm run test:run": "tests:unit",
    "test-root: npm run test:acceptance": "tests:acceptance",
    "test-root: npm run render:guard": "static:render-guard",
    "test-root: npm run desc:budget-guard": "static:desc-budget-guard",
    "test-mcp: bash tools/release/npm-ci-retry.sh": "install",
    "test-mcp: tsc --noEmit": "static:tsc-build",
    "test-mcp: npm run cli:vocab-guard": "static:cli-vocab-guard",
    "grep-gates: bash tools/audit/gates/check-withsession-idempotency.sh src": "static:withsession-idempotency",
    "grep-gates: bash tests/scripts/check-withsession-idempotency.test.sh": "selftest:withsession-idempotency-self-test",
    "grep-gates: bash tools/audit/gates/check-begin-immediate-substrate.sh src": "static:begin-immediate-substrate",
    "grep-gates: bash tests/scripts/check-begin-immediate-substrate.test.sh": "selftest:begin-immediate-substrate-self-test",
    "grep-gates: node tools/audit/gates/check-query-upcast-choke-point.mjs": "static:query-upcast-choke-point",
    "grep-gates: node tools/audit/gates/check-no-state-json.mjs": "static:no-state-json",
    "grep-gates: node tools/audit/gates/check-single-workflow-fold.mjs": "static:single-workflow-fold",
    "grep-gates: node tools/audit/gates/check-event-store-composition-root.mjs": "static:event-store-composition-root",
    "grep-gates: node tools/audit/gates/check-windows-portability.mjs": "static:windows-portability",
    "grep-gates: bash tests/scripts/check-windows-portability.test.sh": "selftest:windows-portability-self-test",
    "grep-gates: node tools/audit/gates/check-wlm-wiring.mjs": "static:wlm-wiring",
    "grep-gates: bash tests/scripts/check-wlm-wiring.test.sh": "selftest:wlm-wiring-self-test",
    "grep-gates: node tools/audit/gates/check-gate-runner-ownership.mjs": "static:gate-runner-ownership",
    "grep-gates: bash tests/scripts/check-gate-runner-ownership.test.sh": "selftest:gate-runner-ownership-self-test",
    "grep-gates: node tools/audit/gates/check-type-debt.mjs": "static:type-debt",
    "grep-gates: bash tests/scripts/check-type-debt.test.sh": "selftest:type-debt-self-test",
    "grep-gates: bash tests/scripts/check-coverage-ratchet.test.sh": "selftest:coverage-ratchet-self-test",
    "grep-gates: node tools/audit/gates/check-enforcer-wiring.mjs": "static:enforcer-wiring",
    "grep-gates: bash tests/scripts/check-enforcer-wiring.test.sh": "selftest:enforcer-wiring-self-test",
    "grep-gates: bash tools/audit/gates/validate-plugin.sh": "static:validate-plugin",
    "grep-gates: bash tests/scripts/validate-plugin.test.sh": "selftest:validate-plugin-self-test",
    "grep-gates: node tools/audit/gates/run-validate.mjs --list": "static:validate-manifest-list",
    "grep-gates: bash tests/scripts/npm-ci-retry.test.sh": "selftest:npm-ci-retry-self-test",
    "grep-gates: bash tools/release/npm-ci-retry.sh": "install",
    "grep-gates: npm run lint:invariants": "static:lint-invariants",
    "grep-gates: npm run lint:envelopes": "static:lint-envelopes",
    "grep-gates: bash tests/scripts/lint-envelopes.test.sh": "selftest:lint-envelopes-self-test",
    "grep-gates: node tools/eslint-rules/no-handler-throw.test.js": "static:no-handler-throw-rule",
    "grep-gates: tsc -p tools/eslint-rules/tsconfig.json": "static:tsc-eslint-rules",
    "grep-gates: npm run lint:comments": "static:lint-comments",
    "grep-gates: bash tests/scripts/lint-comments.test.sh": "selftest:lint-comments-self-test",
    "grep-gates: bash tests/scripts/check-eslint-windows.test.sh": "selftest:eslint-windows-self-test",
