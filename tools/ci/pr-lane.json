{
  "fullModeGlobs": [
    "package.json",
    "package-lock.json",
    "vitest.config.*",
    "tsconfig*.json",
    "tests/tsconfig*.json",
    "tests/helpers/**",
    "tools/ci/**",
    ".bun-version"
  ],
  "static": {
    "build": [
      { "id": "tsc-build", "run": "npx --no-install tsc" },
      { "id": "tsc-conformance", "run": "npx --no-install tsc --noEmit -p tools/conformance" },
      { "id": "tsc-tests", "run": "npx --no-install tsc --noEmit -p tests" },
      { "id": "tsc-scripts", "run": "npx --no-install tsc -p tsconfig.scripts.json" },
      { "id": "tsc-eslint-rules", "run": "npx --no-install tsc -p tools/eslint-rules/tsconfig.json" }
    ],
    "gates": [
      { "id": "installer-shells", "run": "command -v bash >/dev/null && { command -v pwsh >/dev/null || command -v powershell >/dev/null; }" },
      { "id": "withsession-idempotency", "run": "bash tools/audit/gates/check-withsession-idempotency.sh src" },
      { "id": "begin-immediate-substrate", "run": "bash tools/audit/gates/check-begin-immediate-substrate.sh src" },
      { "id": "query-upcast-choke-point", "run": "node tools/audit/gates/check-query-upcast-choke-point.mjs" },
      { "id": "no-state-json", "run": "node tools/audit/gates/check-no-state-json.mjs" },
      { "id": "single-workflow-fold", "run": "node tools/audit/gates/check-single-workflow-fold.mjs" },
      { "id": "event-store-composition-root", "run": "node tools/audit/gates/check-event-store-composition-root.mjs" },
      { "id": "windows-portability", "run": "node tools/audit/gates/check-windows-portability.mjs" },
      { "id": "wlm-wiring", "run": "node tools/audit/gates/check-wlm-wiring.mjs" },
      { "id": "gate-runner-ownership", "run": "node tools/audit/gates/check-gate-runner-ownership.mjs" },
      { "id": "type-debt", "run": "node tools/audit/gates/check-type-debt.mjs" },
      { "id": "enforcer-wiring", "run": "node tools/audit/gates/check-enforcer-wiring.mjs" },
      { "id": "validate-plugin", "run": "bash tools/audit/gates/validate-plugin.sh" },
      { "id": "validate-manifest-list", "run": "node tools/audit/gates/run-validate.mjs --list" },
      { "id": "lint-invariants", "run": "npm run -s lint:invariants" },
      { "id": "lint-envelopes", "run": "npm run -s lint:envelopes" },
      { "id": "no-handler-throw-rule", "run": "node tools/eslint-rules/no-handler-throw.test.js" },
      { "id": "prefix-fingerprint", "run": "node tools/audit/gates/check-prefix-fingerprint.mjs" },
      { "id": "prose-lint", "run": "node tools/audit/gates/check-prose-lint.mjs" },
      { "id": "primary-owner-population", "run": "node tools/audit/core/measure-primary-owner-population.mjs --check" },
      { "id": "module-intent", "run": "node tools/audit/gates/check-module-intent.mjs" },
      { "id": "output-schema-ratchet", "run": "npx --no-install tsx tools/audit/core/output-schema-ratchet-guard.ts" },
      { "id": "cli-derivation-ratchet", "run": "npx --no-install tsx tools/audit/core/cli-derivation-ratchet-guard.ts" },
      { "id": "cli-derivation-guard", "run": "npx --no-install tsx tools/audit/core/cli-derivation-guard.ts" },
      { "id": "report-coupling-ratchet", "run": "npx --no-install tsx tools/audit/core/report-coupling-ratchet-guard.ts" },
      { "id": "render-guard", "run": "npm run -s render:guard" },
      { "id": "desc-budget-guard", "run": "npm run -s desc:budget-guard" },
      { "id": "cli-vocab-guard", "run": "npm run -s cli:vocab-guard" },
      {
        "id": "lint-comments",
        "run": "node tools/audit/gates/lint-comments.mjs --base {base}",
        "exclusive": true,
        "diffScope": {
          "why": "Every comment rule reads one file, the policy and the baseline. No rule is type-aware, so a change to one file cannot change the verdict on another. The full globs are the inputs that can.",
          "maxFiles": 300,
          "fullGlobs": ["eslint.config.js", "tools/eslint-rules/**", "tools/audit/lib/**", "tools/audit/gates/lint-comments.mjs", "tools/audit/comment-quality/**", ".exarchos/comment-policy.json", "package.json", "package-lock.json"]
        }
      },
      { "id": "cycle-gate", "run": "npx --no-install tsx tools/audit/cycle-gate.ts", "exclusive": true },
      { "id": "conformance", "run": "npx --no-install vitest run --project conformance --reporter=dot --maxWorkers={workers}", "exclusive": true },
      { "id": "architecture", "run": "npx --no-install vitest run --project unit tests/architecture --reporter=dot --maxWorkers={workers}", "exclusive": true }
    ],
    "selfTestSharedTriggers": [
      "tests/scripts/lib/**",
      "tests/scripts/__fixtures__/**",
      "tools/audit/lib/**"
    ],
    "selfTests": [
      { "id": "withsession-idempotency-self-test", "run": "bash tests/scripts/check-withsession-idempotency.test.sh", "paths": ["tools/audit/gates/check-withsession-idempotency.sh"] },
      { "id": "begin-immediate-substrate-self-test", "run": "bash tests/scripts/check-begin-immediate-substrate.test.sh", "paths": ["tools/audit/gates/check-begin-immediate-substrate.sh"] },
      { "id": "windows-portability-self-test", "run": "bash tests/scripts/check-windows-portability.test.sh", "paths": ["tools/audit/gates/check-windows-portability.mjs"] },
      { "id": "wlm-wiring-self-test", "run": "bash tests/scripts/check-wlm-wiring.test.sh", "paths": ["tools/audit/gates/check-wlm-wiring.mjs"] },
      { "id": "gate-runner-ownership-self-test", "run": "bash tests/scripts/check-gate-runner-ownership.test.sh", "paths": ["tools/audit/gates/check-gate-runner-ownership.mjs"] },
      { "id": "type-debt-self-test", "run": "bash tests/scripts/check-type-debt.test.sh", "paths": ["tools/audit/gates/check-type-debt.mjs"] },
      { "id": "coverage-ratchet-self-test", "run": "bash tests/scripts/check-coverage-ratchet.test.sh", "paths": ["tools/audit/gates/check-coverage-ratchet.mjs"] },
      { "id": "enforcer-wiring-self-test", "run": "bash tests/scripts/check-enforcer-wiring.test.sh", "paths": ["tools/audit/gates/check-enforcer-wiring.mjs"] },
      { "id": "validate-plugin-self-test", "run": "bash tests/scripts/validate-plugin.test.sh", "paths": ["tools/audit/gates/validate-plugin.sh"] },
      { "id": "npm-ci-retry-self-test", "run": "bash tests/scripts/npm-ci-retry.test.sh", "paths": ["tools/release/npm-ci-retry.sh"] },
      { "id": "lint-envelopes-self-test", "run": "bash tests/scripts/lint-envelopes.test.sh", "paths": ["tools/audit/gates/lint-envelopes.mjs", "tools/eslint-rules/**", "eslint.config.js"] },
      { "id": "lint-comments-self-test", "run": "bash tests/scripts/lint-comments.test.sh", "paths": ["tools/audit/gates/lint-comments.mjs", "tools/audit/comment-quality/**", "tools/eslint-rules/**", ".exarchos/comment-policy.json", "eslint.config.js"] },
      { "id": "eslint-windows-self-test", "run": "bash tests/scripts/check-eslint-windows.test.sh", "paths": ["eslint.config.js", "tools/eslint-rules/**"] },
      { "id": "mutation-gate-self-test", "run": "bash tests/scripts/check-mutation-gate.test.sh", "paths": ["tools/audit/gates/check-mutation-gate.mjs"] },
      { "id": "cycle-gate-self-test", "run": "bash tests/scripts/audit/cycle-gate.test.sh", "paths": ["tools/audit/cycle-gate.ts"] },
      { "id": "knip-diff-self-test", "run": "bash tests/scripts/audit/knip-diff.test.sh", "paths": ["tools/audit/knip-diff.ts", "knip.json"] },
      { "id": "module-intent-self-test", "run": "bash tests/scripts/check-module-intent.test.sh", "paths": ["tools/audit/gates/check-module-intent.mjs"] }
    ]
  },
  "tests": {
    "gates": [
      { "id": "validate-no-legacy", "run": "bash tools/audit/gates/validate-no-legacy.sh", "why": "knip parses with oxc raw transfer, which reserves a buffer of several GiB. The 4 GiB agent of the static suite refuses it." }
    ],
    "acceptanceFullGlobs": ["content/**", "rendered/**", "hooks/**", "binding/**", "manifest.json", "settings.json", "tests/acceptance/**"],
    "binaryTierGlobs": ["src/**", "tests/process/**", "tests/outcome/**", "tools/release/**", "hooks/**", "binding/**"],
    "forcedCore": [
      "tests/unit/architecture/**",
      "tests/unit/install/advisory-registry.test.ts",
      "tests/unit/install/shim-registry.test.ts",
      "tests/unit/events/grep-gates.test.ts",
      "tests/unit/events/atomic-appender-consumers.test.ts",
      "tests/unit/tsconfig-strictness.test.ts",
      "tests/unit/output-schema-vacuity-allowlist.test.ts",
      "tests/core/scripts/**",
      "tests/core/packaged/**",
      "tests/core/process/**"
    ],
    "coreTestGlobs": ["src/**/*.test.ts", "tests/core/**/*.test.ts", "tests/unit/**/*.test.ts", "tests/integration/**/*.test.ts", "tools/evals/**/*.test.ts", "tools/test-helpers/**/*.test.ts"],
    "repoReaderPattern": "\\bREPO_ROOT\\b|git ls-files|'ls-files'",
    "processFloor": 23,
    "networkOnly": {
      "tests/scripts/npm-publish-target.test.ts": "npm publish --dry-run asks registry.npmjs.org for the package, and the lane runs with no network. The push-to-main run of ci.yml runs it."
    }
  },
  "postMerge": {
    "ci-gate: Require every gated job to succeed": "The push-run verdict. On a pull request, the Buildkite aggregate status plays this role.",
    "test-mcp: npm run test:coverage": "The coverage run stays on the push-to-main run of ci.yml.",
    "test-mcp: node tools/audit/gates/check-coverage-ratchet.mjs": "The coverage ratchet reads the coverage run, so it runs after merge.",
    "test-mcp: vitest run tools/evals/evals/harness.test.ts tools/evals/evals/graders/llm-rubric.test.ts": "The eval lane needs model credentials.",
    "test-mcp: node tools/audit/gates/check-mutation-gate.mjs --observe": "Observe mode does not gate.",
    "test-mcp: vitest run tests/unit/verbs/stryker-adapter.smoke.test.ts": "The Stryker smoke test does not gate.",
    "test-windows: bash tools/release/npm-ci-retry.sh": "Windows runs on Actions.",
    "test-windows: npm run test:core": "Windows runs on Actions.",
    "test-windows: Guard — worktree suite executed on Windows (DR-11s)": "Windows runs on Actions.",
    "test-windows: DR-8 — named win32-fragile launcher tests (spawn 003 + path 009)": "Windows runs on Actions.",
    "test-windows-root: bash tools/release/npm-ci-retry.sh": "Windows runs on Actions.",
    "test-windows-root: npm run test:run": "Windows runs on Actions.",
    "binary-matrix: bash tools/release/npm-ci-retry.sh": "The five-target binary build runs after merge.",
    "binary-matrix: bun run tools/release/build-binary.ts --target ${{ matrix.target }}": "The five-target binary build runs after merge.",
    "startup-budget: bash tools/release/npm-ci-retry.sh": "Cold-start budgets need a quiet host.",
    "startup-budget: bun run tools/release/build-binary.ts --target linux-x64": "Cold-start budgets need a quiet host.",
    "startup-budget: Run cold-start budgets": "Cold-start budgets need a quiet host.",
    "testgen: npm ci --ignore-scripts": "Testgen needs five operating systems and .NET.",
    "testgen: bun tools/release/codegen-testgen.ts --check": "Testgen needs five operating systems and .NET.",
    "testgen: npm run build:testgen": "Testgen needs five operating systems and .NET.",
    "testgen: npm run testgen:smoke": "Testgen needs five operating systems and .NET.",
    "testgen: Run generated tests against Exarchos bindings": "Testgen needs five operating systems and .NET."
  },
  "ciCoverage": {
