{
  "name": "@lvlup-sw/exarchos",
  "version": "2.12.0-preview.3",
  "description": "Structure for agentic development \u2014 durable SDLC workflows, convergence gates, agent teams, and audit trails for Claude Code",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "exarchos-release-verify": "dist/release-verify.js"
  },
  "files": [
    "dist/bin",
    "dist/release-verify.js",
    "rendered",
    "scripts",
    "hooks",
    "settings.json",
    ".claude-plugin",
    "AGENTS.md",
    "!**/*.test.sh",
    "!**/*.test.ts",
    "!**/test-fixtures"
  ],
  "scripts": {
    "build": "npm run codegen:runtimes && tsc && npm run build:binary && npm run build:release-verifier && npm run build:skills && npm run build:hooks",
    "build:binary": "bun run scripts/build-binary.ts --all",
    "build:release-verifier": "bun build src/install/release/release-verify-cli.ts --target=node --format=esm --banner \"#!/usr/bin/env node\" --outfile dist/release-verify.js",
    "codegen:runtimes": "bun run scripts/codegen-runtimes.ts",
    "runtimes:guard": "npm run codegen:runtimes && git diff --exit-code -- src/install/runtimes/embedded.ts || (echo 'src/install/runtimes/embedded.ts is out of sync with content/harness/runtimes/*.yaml \u2014 run npm run codegen:runtimes' && exit 1)",
    "generate:agents": "tsx src/runtime/agents/generate-agents.ts",
    "generate:docs": "tsx scripts/core/generate-docs.ts",
    "build:skills": "npm run generate:agents && node dist/install/build-skills.js",
    "build:hooks": "node dist/install/build-hooks.js",
    "lint": "eslint \"src/**/*.ts\" \"tools/conformance/src/**/*.ts\"",
    "quality-check": "npm run lint:invariants && npm run lint:test-first-drift",
    "lint:inv6": "node scripts/lint-inv6.mjs content/",
    "lint:test-first-drift": "node scripts/lint-test-first-drift.mjs content rendered/agents",
    "lint:invariants": "tsx src/architecture/vocabulary-lint-cli.ts",
    "lint:envelopes": "node scripts/lint-envelopes.mjs",
    "cli:vocab-guard": "bun run scripts/core/cli-vocab-guard.ts",
    "vendor:sync:pm-detector": "tsx scripts/core/sync-vendor-pm-detector.ts",
    "vendor:check:pm-detector": "tsx scripts/core/sync-vendor-pm-detector.ts --check",
    "desc:budget-guard": "tsx tools/conformance/src/description-budget-cli.ts",
    "skills:guard": "npm run render:guard",
    "hooks:guard": "npm run render:guard",
    "prepare": "tsc",
    "bench": "vitest bench",
    "bench:plan-format": "tsx tools/evals/evals/benchmarks/plan-format-corpus.ts",
    "test": "vitest",
    "test:unit": "vitest run --project unit --project integration",
    "test:process": "vitest run --project process --passWithNoTests",
    "test:all": "vitest run",
    "test:outcome": "vitest run --project outcome",
    "test:conformance": "vitest run --project conformance",
    "test:core": "vitest run --project core",
    "test:coverage": "vitest run --project core --coverage",
    "test:run": "npm run test:unit",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tools/conformance",
    "version:sync": "bash scripts/sync-versions.sh",
    "version:check": "bash scripts/sync-versions.sh --check",
    "validate": "node scripts/run-validate.mjs",
    "validate:list": "node scripts/run-validate.mjs --list",
    "docs:dev": "cd documentation && npm run docs:dev",
    "docs:build": "cd documentation && npm run docs:build",
    "docs:preview": "cd documentation && npm run docs:preview",
    "lint:windows": "npm run lint",
    "render:guard": "node dist/install/render-guard.js && npm run runtimes:guard && (npm run lint:inv6 || true) && npm run lint:test-first-drift"
  },
  "keywords": [
    "claude-code-plugin",
    "sdlc",
    "workflow",
    "agent-governance",
    "agent-teams",
    "event-sourcing",
    "code-review",
    "quality-gates",
    "tdd",
    "durable-workflows",
    "audit-trail"
  ],
  "author": "lvlup-sw",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvlup-sw/exarchos.git"
  },
  "homepage": "https://github.com/lvlup-sw/exarchos#readme",
  "bugs": {
    "url": "https://github.com/lvlup-sw/exarchos/issues"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.2.4",
    "@iarna/toml": "^2.2.5",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/iarna__toml": "^2.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitest/coverage-v8": "^3.0.0",
    "better-sqlite3": "^12.6.2",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9.39.4",
    "fast-check": "^4.5.3",
    "knip": "^6.6.2",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.62.0",
    "vitest": "^3.0.0",
    "yauzl": "^3.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.2.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "commander": "^14.0.3",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.1",
    "pino": "^10.3.1",
    "yaml": "^2.8.2",
    "yazl": "3.3.1",
    "zod": "^4.4.3"
  }
}
