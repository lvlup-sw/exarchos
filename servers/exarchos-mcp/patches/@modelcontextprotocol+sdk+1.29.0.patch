         }
+        // [exarchos patch #1366] accept v3 ZodDiscriminatedUnion. v3 DUs don't
+        // expose `.shape` on the union itself (the shape lives on each member),
+        // but the SDK should still treat the union as an object-rooted schema.
+        // Detect via `_def.typeName === 'ZodDiscriminatedUnion'`.
+        if (v3Schema._def && v3Schema._def.typeName === 'ZodDiscriminatedUnion') {
