diff --git a/node_modules/@modelcontextprotocol/sdk/dist/esm/server/zod-compat.js b/node_modules/@modelcontextprotocol/sdk/dist/esm/server/zod-compat.js
index be30a22..6b25dac 100644
--- a/node_modules/@modelcontextprotocol/sdk/dist/esm/server/zod-compat.js
+++ b/node_modules/@modelcontextprotocol/sdk/dist/esm/server/zod-compat.js
@@ -106,7 +106,16 @@ export function normalizeObjectSchema(schema) {
         // Check if it's a v4 object
         const v4Schema = schema;
         const def = v4Schema._zod?.def;
-        if (def && (def.type === 'object' || def.shape !== undefined)) {
+        // [exarchos patch #1366] accept ZodDiscriminatedUnion: a v4 DU has
+        // def.type === 'union' and a string `discriminator` field (distinguishing
+        // it from a plain ZodUnion). MCP spec tool schemas are always object-rooted,
+        // but a top-level DU IS structurally an object (every variant is). Without
+        // this branch normalizeObjectSchema returns undefined and the SDK falls
+        // back to EMPTY_OBJECT_JSON_SCHEMA, dropping the LCD. See upstream PR (TBD).
+        if (def &&
+            (def.type === 'object' ||
+                def.shape !== undefined ||
+                (def.type === 'union' && typeof def.discriminator === 'string'))) {
             return schema;
         }
     }
@@ -116,6 +125,13 @@ export function normalizeObjectSchema(schema) {
